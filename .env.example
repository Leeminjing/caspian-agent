# Caspian Agent 环境变量
# 复制此文件为 .env 并填入实际值: cp .env.example .env

# DeepSeek API Key (必填)
OPENAI_API_KEY=sk-REPLACE_ME

# JWT 签名密钥 (必填，用于用户认证)
JWT_SECRET=your-jwt-secret-here

# 沙箱后端 (必填，config.yaml 的 sandbox.use 引用此变量)
# 容器沙箱(默认): CASPIAN_SANDBOX=caspian.community.aio_sandbox.aio_sandbox:AioSandbox
# 本机沙箱(开发): CASPIAN_SANDBOX=caspian.sandbox.local:LocalSandbox
CASPIAN_SANDBOX=caspian.community.aio_sandbox.aio_sandbox:AioSandbox
