# Caspian Agent 环境变量
# 复制此文件为 .env 并填入实际值: cp .env.example .env

# DeepSeek API Key (必填)
OPENAI_API_KEY=sk-REPLACE_ME

# 数据库 URL (必填，config.yaml 的 database.url 引用此变量)
# 本机开发: postgresql+asyncpg://caspian:qweasdzxc123@127.0.0.1:7221/caspian
# Compose 部署: postgresql+asyncpg://caspian:caspian@postgres:5432/caspian
DATABASE_URL=postgresql+asyncpg://caspian:qweasdzxc123@127.0.0.1:7221/caspian

# 向量嵌入 API Key (config.yaml 的 langgraph_store.embed_api_key 引用此变量；用到知识库/存储语义检索时必填)
DASHSCOPE_API_KEY=REPLACE_ME

# 沙箱后端 (必填，config.yaml 的 sandbox.use 引用此变量)
# 容器沙箱(默认): CASPIAN_SANDBOX=caspian.community.aio_sandbox.aio_sandbox:AioSandbox
# 本机沙箱(开发): CASPIAN_SANDBOX=caspian.sandbox.local:LocalSandbox
CASPIAN_SANDBOX=caspian.community.aio_sandbox.aio_sandbox:AioSandbox
